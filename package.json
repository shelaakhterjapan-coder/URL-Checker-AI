{
  "name": "custom-browser",
  "version": "1.0.0",
  "description": "Custom Desktop Web Browser (Electron + BrowserView)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.shelaakhterjapancoder.custombrowser",
    "productName": "Custom Browser — shelaakhterjapan-coder",
    "files": [
      "**/*",
      "!node_modules/**/test/**"
    ],
    "directories": {
      "buildResources": "build"
    }
  }
}
